# Required
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
GOOGLE_API_KEY=your_google_cloud_api_key_with_tts_enabled

# Access control (recommended) — comma-separated Telegram chat IDs allowed to use
# the bot. Leave blank to allow everyone (anyone who finds the bot can spend your
# TTS quota). Get your ID from @userinfobot on Telegram.
ALLOWED_CHAT_IDS=

# Gemini TTS (optional) — when GEMINI_API_KEY is set the bot narrates with Gemini and
# falls back to Chirp (above) only when the Gemini daily quota runs out.
# Key from Google AI Studio (not the Cloud TTS key). Thai needs Flash TTS, not Flash-Lite.
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Default reader until /settings picks one: jan (น้องแจน) · tom (คุณทอม) · leng (ป้าเล้ง) · dak (พี่แด๊ก)
TTS_PERSONA=jan
GEMINI_PART_SIZE=14000

# Voice (optional) — any Google Cloud TTS voice name (Chirp, also the Gemini fallback)
TTS_VOICE=th-TH-Chirp3-HD-Achernar

# Usage metering (optional) — leave blank to disable persistent quota tracking
SUPABASE_URL=
SUPABASE_KEY=
TTS_MONTHLY_FREE_CHARS=1000000

# Tuning (optional)
COLLECT_WINDOW_SECONDS=5
TTS_PART_SIZE=1950
PORT=8443
